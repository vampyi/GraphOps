# copy this file to .env and choose your own local password
NEO4J_PASSWORD=change-me-local-only
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j

# live replay through kafka. leave KAFKA_BOOTSTRAP empty to write the replay straight into neo4j.
KAFKA_BOOTSTRAP=localhost:9092
# hosted kafka such as aiven only: username, password and the service's certificate authority
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_CA_PEM=

# sarvam ai for the incident story and the ask tab. without it the story shows the incident's facts and the
# ask tab explains that no key is set.
SARVAM_API_KEY=

# respond panel email (optional): a gmail address with an app password, and who may be emailed, as json:
# NOTIFY_CONTACTS=[{"name": "Vatanesh", "email": "...", "role": "IT admin"}]
SMTP_USER=
SMTP_APP_PASSWORD=
NOTIFY_CONTACTS=

# real sources (team laptops through osquery, a claude code agent) send this token in X-GraphOps-Token.
# without it the source endpoints refuse every write. choose a long random value; share it privately.
INGEST_TOKEN=
